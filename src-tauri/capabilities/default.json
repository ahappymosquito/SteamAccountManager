{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capabilities required by the main application window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-close",
    "dialog:allow-open",
    "dialog:allow-save",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        {
          "url": "https://github.com/ahappymosquito/SteamAccountManager*"
        },
        {
          "url": "https://developer.valvesoftware.com/wiki/*"
        },
        {
          "url": "https://csgo.5eplay.com/*"
        },
        {
          "url": "https://pvp.wanmei.com/*"
        }
      ]
    },
    "clipboard-manager:allow-write-text"
  ]
}
