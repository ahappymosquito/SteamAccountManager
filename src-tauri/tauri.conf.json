{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Steam Account Manager",
  "version": "1.5.0",
  "identifier": "com.steamaccountmanager.desktop",
  "build": { "beforeDevCommand": "npm run dev", "devUrl": "http://localhost:1420", "beforeBuildCommand": "npm run build", "frontendDist": "../dist" },
  "app": {
    "windows": [{ "label": "main", "title": "Steam Account Manager", "width": 1180, "height": 760, "minWidth": 820, "minHeight": 600, "resizable": true, "decorations": false }],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost",
      "assetProtocol": { "enable": true, "scope": ["$APPDATA/avatars/**/*"] }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDFGQ0RBNjI1RDBDQkUwNEIKUldSTDRNdlFKYWJOSDkwd0ExekJiQU5sQnNMRTRHcnR1Q0NDNjdEV0hzYllmR0p2RWlyRFZOMDcK",
      "endpoints": [
        "https://cdn.qrqto.club/app/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "category": "Utility",
    "shortDescription": "Manage remembered local Steam accounts",
    "longDescription": "Unofficial local Steam account manager. Does not store passwords or bypass Steam Guard.",
    "windows": {
      "webviewInstallMode": { "type": "skip" },
      "nsis": {
        "languages": ["SimpChinese"],
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "installerHooks": "./windows/installer-hooks.nsh"
      }
    }
  }
}
